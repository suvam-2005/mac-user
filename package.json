{
  "name": "neonexus-user-mac",
  "version": "1.0.7",
  "description": "Strategixinsights for macOS",
  "main": "dist/electron/main.js",
  "author": "NeoNexus Innovations LLP",
  "private": false,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "dist:mac:intel": "npm run build && electron-builder --mac dmg --x64",
    "dist:mac:apple": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg --universal --publish never",
    "dist:mac:one-command": "bash ./scripts/build-dmg-mac.sh",
    "dist:mac:test": "npm run build && electron-builder --mac dmg --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "oxlint": "^1.58.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "io.neonexus.copilot",
    "productName": "Strategixinsights",
    "afterSign": "scripts/notarize.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [],
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Strategixinsights needs microphone access to capture interview audio for live transcription and AI assistance.",
        "NSScreenCaptureDescription": "Strategixinsights needs screen recording access to capture shared system audio during interview sessions."
      }
    },
    "dmg": {
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [{
        "target": "nsis",
        "arch": ["x64"]
      }],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Strategixinsights",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    }
  }
}
